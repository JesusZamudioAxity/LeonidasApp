{
  "name": "fullleonidas",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "wdio": "wdio run ./wdio.conf.js",
    "start:emulator1": "%ANDROID_SDK_ROOT%\\emulator\\emulator.exe @Pixel_3a",
    "start:emulator": "startEmulador.js",
    "test:mobile": "npx wdio run wdio.conf.js",
    "test:app1": "start \"\" npm run start:emulator1 && adb wait-for-device && timeout /t 30 && npm run test:mobile",
    "test:app": "npm run start:emulator && npm run test:mobile",
    "test:login": "npx wdio run wdio.conf.js --spec ./test/auth/login.test.js",
    "test:tracking": "npx wdio run wdio.conf.js --spec ./test/ASN/tracking.test.js",
    "test:ASN": "npx wdio run wdio.conf.js --spec ./test/ASN/cerrarASN.test.js",
    "test:ran": "npx wdio run wdio.conf.js --spec ./test/almacenamiento/moverRAN.test.js",
    "test:critico": "npx wdio run wdio.conf.js --spec ./test/almacenamiento/almacenamientoCritico.test.js",
    "test:normal": "npx wdio run wdio.conf.js --spec ./test/almacenamiento/almacenamientoNormal.test.js",
    "test:mixed": "npx wdio run wdio.conf.js --spec ./test/almacenamiento/almacenamientoMixed.test.js",
    "test:stringer": "npx wdio run wdio.conf.js --spec ./test/almacenamiento/almacenamientoStringer.test.js",
    "test:masivo": "npx wdio run wdio.conf.js --spec ./test/almacenamiento/almacenamientoMasivo.test.js",
    "report:allure": "npx allure generate allure-results --clean -o allure-report",
    "report:open": "npx allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.20.0",
    "@wdio/appium-service": "^9.19.2",
    "@wdio/cli": "^9.19.2",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "appium-uiautomator2-driver": "^5.0.0"
  },
  "dependencies": {
    "mssql": "^12.0.0"
  }
}
